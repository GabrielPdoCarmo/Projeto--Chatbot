DATABASE_URL="file:./dev.db"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Necessário só para o botão "Sugerir com IA" no painel do Wizard.
# Chave gratuita (sem cartão) em https://aistudio.google.com/apikey
# Sem essa chave, o Wizard ainda funciona normalmente — só digita a
# resposta manualmente em vez de usar a sugestão automática.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Necessária para o botão "Gerar sugestão com IA" no painel do Wizard.
# Sem ela, o Wizard ainda consegue responder manualmente normalmente.
ANTHROPIC_API_KEY=""
